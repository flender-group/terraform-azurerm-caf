{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "export_essentials_output.schema.json",
  "title": "Export Essentials Output",
  "description": "Schema for the JSON blob produced by the export_essentials module's outputs local",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "azuread_applications": {
      "description": "Azure AD applications keyed by resource map key",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "application_id": { "type": "string" },
          "object_id":      { "type": "string" },
          "display_name":   { "type": "string" }
        }
      }
    },
    "azuread_groups": {
      "description": "Azure AD groups keyed by resource map key",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id":    { "type": "string" },
          "display_name": { "type": "string" }
        }
      }
    },
    "azuread_service_principals": {
      "description": "Azure AD service principals keyed by resource map key",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "application_id": { "type": "string" },
          "object_id":      { "type": "string" },
          "rbac_id":        { "type": "string" },
          "display_name":   { "type": "string" }
        }
      }
    },
    "keyvaults": {
      "description": "Key Vaults keyed by resource map key",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id":        { "type": "string" },
          "name":      { "type": "string" },
          "vault_uri": { "type": "string", "format": "uri" }
        }
      }
    },
    "storage_accounts": {
      "description": "Storage accounts keyed by resource map key",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id":                     { "type": "string" },
          "name":                   { "type": "string" },
          "primary_blob_endpoint":  { "type": "string", "format": "uri" }
        }
      }
    },
    "vnets": {
      "description": "Virtual networks keyed by vnet name",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id":            { "type": "string" },
          "name":          { "type": "string" },
          "address_space": {
            "type": "array",
            "items": { "type": "string", "format": "cidr" }
          },
          "subnets": {
            "description": "Subnets within this vnet keyed by subnet name",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id":   { "type": "string" },
                "name": { "type": "string" },
                "cidr": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "public_dns": {
      "description": "Public DNS zones keyed by zone name",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id":                  { "type": "string" },
          "name":                { "type": "string" },
          "resource_group_name": { "type": "string" }
        }
      }
    },
    "private_dns": {
      "description": "Private DNS zones keyed by zone name",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id":                  { "type": "string" },
          "name":                { "type": "string" },
          "resource_group_name": { "type": "string" }
        }
      }
    },
    "credentials": {
      "description": "Azure AD application credentials keyed by resource map key",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_secret_secret_name":           { "type": "object", "additionalProperties": { "type": "string" } },
          "client_secret_secret_versionless_id": { "type": "object", "additionalProperties": { "type": "string" } },
          "client_secret_secret_key_vault_id":   { "type": "object", "additionalProperties": { "type": "string" } },
          "client_id_secret_name":               { "type": "object", "additionalProperties": { "type": "string" } },
          "client_id_secret_versionless_id":     { "type": "object", "additionalProperties": { "type": "string" } },
          "client_id_secret_key_vault_id":       { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    },
    "managed_identities": {
      "description": "Managed identities keyed by resource map key",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "principal_id": { "type": "string" },
          "client_id":    { "type": "string" },
          "id":           { "type": "string" },
          "name":         { "type": "string" },
          "rbac_id":      { "type": "string" }
        }
      }
    }
  }
}
